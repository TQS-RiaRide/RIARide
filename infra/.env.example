# Copy to infra/.env (git-ignored) and replace every value. Never commit infra/.env.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password given to every synthetic user created by infra/keycloak/create-dev-users.sh
DEV_USER_PASSWORD=change-me
# Host ports, if the defaults are taken by something else
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
