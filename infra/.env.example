# Copy to infra/.env (git-ignored) and replace every value. Never commit infra/.env.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password given to every synthetic user created by infra/keycloak/create-dev-users.sh
DEV_USER_PASSWORD=change-me
# Host ports, if the defaults are taken by something else
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
MQTT_PORT=1883
# Only with the "app" profile (backend and frontend in containers)
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Secret of the backend's Keycloak client riaride-backend (Admin API, guest sign-up).
# Keycloak generates it on realm import: copy it from Clients > riaride-backend > Credentials.
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me
# Stripe test mode secret key (sk_test_...), needed only for pass purchases.
# Left empty, the backend container starts with a placeholder test mode key.
STRIPE_SECRET_KEY=
